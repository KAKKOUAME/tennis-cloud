# 复制为 .env 后修改（server.js 直接用环境变量，无需安装 dotenv）
PORT=3000
# 每日投稿限额（默认 5）
DAILY_LIMIT=5
# 管理员后台密码（务必修改！）
ADMIN_PASS=tennis2026
# ntfy 推送话题（留空则每次随机生成；固定话题便于长期订阅）
NTFY_TOPIC=tennis-coach-yourname
# ntfy 服务地址（默认官方 https://ntfy.sh，可自建）
NTFY_SERVER=https://ntfy.sh
# 部署后的公网地址，用于推送点击跳转（例如 https://your.domain 或 Railway/Render 分配的域名）
BASE_URL=
# 可选：同时发邮件提醒所需 SMTP 代理（留空则不发邮件）
EMAIL_TO=
